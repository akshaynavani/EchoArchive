# Copy to .env and fill in. Never commit .env.
SPRING_PROFILES_ACTIVE=onprem

KAFKA_BOOTSTRAP_SERVERS=localhost:9092

DB_URL=jdbc:postgresql://localhost:5432/echoarchive
DB_USERNAME=echo
DB_PASSWORD=change-me

S3_BUCKET=echoarchive-media
AWS_REGION=us-east-1
# On-prem (MinIO) only; cloud profile uses the AWS default credential chain.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me-at-least-8-chars
